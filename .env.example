POSTGRES_SUPERUSER_PASSWORD=replace-with-local-development-password
POSTGRESEM_RUNTIME_PASSWORD=replace-with-local-runtime-password
POSTGRESEM_AUDIT_WRITER_PASSWORD=replace-with-local-audit-writer-password

# Executor configuration uses environment variables only.
DATABASE_URL=postgresql://postgresem_runtime:replace-with-local-runtime-password@127.0.0.1:55432/postgresem_dev
POSTGRESEM_AUDIT_DATABASE_URL=postgresql://postgresem_audit_writer:replace-with-local-audit-writer-password@127.0.0.1:55432/postgresem_dev
POSTGRESEM_DB_ROLE=postgresem_analyst
POSTGRESEM_MAX_RESULT_BYTES=1048576
POSTGRESEM_STATEMENT_TIMEOUT_MS=30000
POSTGRESEM_LOCK_TIMEOUT_MS=5000
POSTGRESEM_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=5000
