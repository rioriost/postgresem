POSTGRES_SUPERUSER_PASSWORD=replace-with-local-development-password
POSTGRESEM_RUNTIME_PASSWORD=replace-with-local-runtime-password
POSTGRESEM_AUDIT_WRITER_PASSWORD=replace-with-local-audit-writer-password
POSTGRESEM_MUTATION_RUNTIME_PASSWORD=replace-with-local-mutation-runtime-password
POSTGRESEM_PREVIOUS_BIN=
POSTGRESEM_REQUIRE_PREVIOUS_BIN=0

# Optional Meaning Lab planner. No API key is required for the default comparison.
# Explicit opt-in sends fictional schema / published model metadata and fixed
# questions to OpenAI, never source rows. Keep the key out of version control.
POSTGRESEM_DEMO_OPENAI=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Executor configuration uses environment variables only.
DATABASE_URL=postgresql://postgresem_runtime:replace-with-local-runtime-password@127.0.0.1:55432/postgresem_dev?sslmode=disable
POSTGRESEM_AUDIT_DATABASE_URL=postgresql://postgresem_audit_writer:replace-with-local-audit-writer-password@127.0.0.1:55432/postgresem_dev?sslmode=disable
POSTGRESEM_DB_ROLE=postgresem_analyst
POSTGRESEM_MUTATION_DATABASE_URL=******127.0.0.1:55432/postgresem_dev?sslmode=disable
POSTGRESEM_MUTATION_DB_ROLE=postgresem_order_writer
POSTGRESEM_MAX_MUTATION_RESULT_BYTES=1048576
POSTGRESEM_MUTATION_STATEMENT_TIMEOUT_MS=30000
POSTGRESEM_MUTATION_LOCK_TIMEOUT_MS=5000
POSTGRESEM_MUTATION_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=5000
POSTGRESEM_MAX_RESULT_BYTES=1048576
POSTGRESEM_STATEMENT_TIMEOUT_MS=30000
POSTGRESEM_LOCK_TIMEOUT_MS=5000
POSTGRESEM_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=5000

# MCP stdio configuration is fixed when `postgresem mcp serve` starts.
POSTGRESEM_MCP_PROJECT=commerce
MCP_RUNTIME_DATABASE_URL=postgresql://postgresem_runtime@127.0.0.1:55432/postgresem_dev?sslmode=disable
MCP_AUDIT_DATABASE_URL=postgresql://postgresem_audit_writer@127.0.0.1:55432/postgresem_dev?sslmode=disable
POSTGRESEM_MCP_RUNTIME_URL_ENV=MCP_RUNTIME_DATABASE_URL
POSTGRESEM_MCP_RUNTIME_PASSWORD_ENV=POSTGRESEM_RUNTIME_PASSWORD
POSTGRESEM_MCP_AUDIT_URL_ENV=MCP_AUDIT_DATABASE_URL
POSTGRESEM_MCP_AUDIT_PASSWORD_ENV=POSTGRESEM_AUDIT_WRITER_PASSWORD
POSTGRESEM_MCP_DB_ROLE_ENV=POSTGRESEM_DB_ROLE
MCP_MUTATION_DATABASE_URL=postgresql://postgresem_mutation_runtime@127.0.0.1:55432/postgresem_dev?sslmode=disable
POSTGRESEM_MCP_MUTATION_URL_ENV=MCP_MUTATION_DATABASE_URL
POSTGRESEM_MCP_MUTATION_PASSWORD_ENV=POSTGRESEM_MUTATION_RUNTIME_PASSWORD
POSTGRESEM_MCP_MUTATION_DB_ROLE_ENV=POSTGRESEM_MUTATION_DB_ROLE
