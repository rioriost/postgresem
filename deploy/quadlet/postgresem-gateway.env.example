MCP_RUNTIME_DATABASE_URL=host=postgresem-db port=5432 dbname=postgresem_dev user=postgresem_runtime sslmode=disable
MCP_AUDIT_DATABASE_URL=host=postgresem-db port=5432 dbname=postgresem_dev user=postgresem_audit_writer sslmode=disable
MCP_MUTATION_DATABASE_URL=host=postgresem-db port=5432 dbname=postgresem_dev user=postgresem_mutation_runtime sslmode=disable
POSTGRESEM_RUNTIME_PASSWORD=replace-with-local-runtime-password
POSTGRESEM_AUDIT_WRITER_PASSWORD=replace-with-local-audit-writer-password
POSTGRESEM_MUTATION_RUNTIME_PASSWORD=replace-with-local-mutation-runtime-password
POSTGRESEM_DB_ROLE=postgresem_analyst
POSTGRESEM_MUTATION_DB_ROLE=postgresem_order_writer
POSTGRESEM_MAX_RESULT_BYTES=1048576
POSTGRESEM_STATEMENT_TIMEOUT_MS=30000
POSTGRESEM_LOCK_TIMEOUT_MS=5000
POSTGRESEM_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=5000
POSTGRESEM_MCP_PROJECT=commerce
POSTGRESEM_MCP_RUNTIME_URL_ENV=MCP_RUNTIME_DATABASE_URL
POSTGRESEM_MCP_RUNTIME_PASSWORD_ENV=POSTGRESEM_RUNTIME_PASSWORD
POSTGRESEM_MCP_AUDIT_URL_ENV=MCP_AUDIT_DATABASE_URL
POSTGRESEM_MCP_AUDIT_PASSWORD_ENV=POSTGRESEM_AUDIT_WRITER_PASSWORD
POSTGRESEM_MCP_DB_ROLE_ENV=POSTGRESEM_DB_ROLE
POSTGRESEM_MCP_MUTATION_URL_ENV=MCP_MUTATION_DATABASE_URL
POSTGRESEM_MCP_MUTATION_PASSWORD_ENV=POSTGRESEM_MUTATION_RUNTIME_PASSWORD
POSTGRESEM_MCP_MUTATION_DB_ROLE_ENV=POSTGRESEM_MUTATION_DB_ROLE
