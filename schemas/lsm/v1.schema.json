{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postgresem.dev/schemas/lsm/v1.schema.json",
  "title": "PostgreSQL Semantic Gateway Logical Semantic Mutation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "model", "idempotency_key", "rows"],
  "properties": {
    "schema_version": {"const": "1"},
    "operation": {"enum": ["insert", "upsert"]},
    "model": {"$ref": "#/$defs/semanticName"},
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "semanticName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "row": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {"$ref": "#/$defs/value"}
    },
    "value": {
      "oneOf": [
        {"$ref": "#/$defs/nullValue"},
        {"$ref": "#/$defs/textValue"},
        {"$ref": "#/$defs/booleanValue"},
        {"$ref": "#/$defs/integerValue"},
        {"$ref": "#/$defs/numericValue"},
        {"$ref": "#/$defs/dateValue"},
        {"$ref": "#/$defs/timestampValue"}
      ]
    },
    "nullValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {"type": {"const": "null"}}
    },
    "textValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "text"},
        "value": {"type": "string"}
      }
    },
    "booleanValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "boolean"},
        "value": {"type": "boolean"}
      }
    },
    "integerValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "integer"},
        "value": {"type": "integer"}
      }
    },
    "numericValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "numeric"},
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      }
    },
    "dateValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "date"},
        "value": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "timestampValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "timestamp"},
        "value": {"type": "string", "format": "date-time"}
      }
    }
  }
}
