{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postgresem.dev/schemas/lsq/v1.schema.json",
  "title": "PostgreSQL Semantic Gateway Logical Semantic Query v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model"],
  "properties": {
    "schema_version": {"const": "1"},
    "model": {"$ref": "#/$defs/semanticName"},
    "dimensions": {
      "type": "array",
      "items": {"$ref": "#/$defs/dimension"},
      "uniqueItems": true
    },
    "metrics": {
      "type": "array",
      "items": {"$ref": "#/$defs/metric"},
      "uniqueItems": true
    },
    "filters": {"$ref": "#/$defs/filter"},
    "order_by": {
      "type": "array",
      "items": {"$ref": "#/$defs/orderBy"}
    },
    "limit": {"type": "integer", "minimum": 1, "maximum": 10000}
  },
  "anyOf": [
    {"required": ["dimensions"], "properties": {"dimensions": {"minItems": 1}}},
    {"required": ["metrics"], "properties": {"metrics": {"minItems": 1}}}
  ],
  "$defs": {
    "semanticName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": {"$ref": "#/$defs/semanticName"},
        "time_grain": {
          "enum": ["day", "week", "month", "quarter", "year"]
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric"],
      "properties": {
        "metric": {"$ref": "#/$defs/semanticName"}
      }
    },
    "orderBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "direction"],
      "properties": {
        "ref": {"$ref": "#/$defs/semanticName"},
        "direction": {"enum": ["asc", "desc"]}
      }
    },
    "literal": {
      "oneOf": [
        {"$ref": "#/$defs/textLiteral"},
        {"$ref": "#/$defs/booleanLiteral"},
        {"$ref": "#/$defs/integerLiteral"},
        {"$ref": "#/$defs/numericLiteral"},
        {"$ref": "#/$defs/dateLiteral"},
        {"$ref": "#/$defs/timestampLiteral"}
      ]
    },
    "textLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "text"},
        "value": {"type": "string"}
      }
    },
    "booleanLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "boolean"},
        "value": {"type": "boolean"}
      }
    },
    "integerLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "integer"},
        "value": {"type": "integer"}
      }
    },
    "numericLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "numeric"},
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      }
    },
    "dateLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "date"},
        "value": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "timestampLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": {"const": "timestamp"},
        "value": {"type": "string", "format": "date-time"}
      }
    },
    "filter": {
      "oneOf": [
        {"$ref": "#/$defs/logicalFilter"},
        {"$ref": "#/$defs/notFilter"},
        {"$ref": "#/$defs/comparisonFilter"},
        {"$ref": "#/$defs/inFilter"},
        {"$ref": "#/$defs/nullFilter"}
      ]
    },
    "logicalFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "args"],
      "properties": {
        "op": {"enum": ["and", "or"]},
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/filter"}
        }
      }
    },
    "notFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "arg"],
      "properties": {
        "op": {"const": "not"},
        "arg": {"$ref": "#/$defs/filter"}
      }
    },
    "comparisonFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "field", "value"],
      "properties": {
        "op": {"enum": ["eq", "not_eq", "gt", "gte", "lt", "lte"]},
        "field": {"$ref": "#/$defs/semanticName"},
        "value": {"$ref": "#/$defs/literal"}
      }
    },
    "inFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "field", "values"],
      "properties": {
        "op": {"const": "in"},
        "field": {"$ref": "#/$defs/semanticName"},
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/literal"}
        }
      }
    },
    "nullFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "field"],
      "properties": {
        "op": {"enum": ["is_null", "is_not_null"]},
        "field": {"$ref": "#/$defs/semanticName"}
      }
    }
  }
}

